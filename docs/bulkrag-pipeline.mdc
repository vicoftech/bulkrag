## Componente 4 — Lambda `bulkrag_insert_pgvector`

```python
"""
Step 5 del pipeline: lee el output de Bedrock Batch y hace bulk insert/update
en Aurora pgvector, mapeando recordId (pdf_key::chunk_index) → chunk en DB.
Input: { "run_id": "...", "tenant": "...", "bucket": "...", "batch_output_prefix": "..." }
"""
import json, os
import boto3

AURORA_SECRET_ARN  = os.environ["AURORA_SECRET_ARN"]
AURORA_CLUSTER_ARN = os.environ["AURORA_CLUSTER_ARN"]
DB_NAME             = os.environ["DB_NAME"]

s3   = boto3.client("s3")
rds  = boto3.client("rds-data")  # Data API de Aurora Serverless


def list_output_files(bucket: str, prefix: str) -> list[str]:
    paginator = s3.get_paginator("list_objects_v2")
    keys = []
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
        for obj in page.get("Contents", []):
            if obj["Key"].endswith(".jsonl.out"):
                keys.append(obj["Key"])
    return keys


def parse_record_id(record_id: str) -> tuple[str, int]:
    # record_id format: "{pdf_key}::chunk_{0001}"
    source_key, chunk_part = record_id.rsplit("::chunk_", 1)
    return source_key, int(chunk_part)


def bulk_upsert(rows: list[tuple]) -> int:
    """
    rows: [(source_key, chunk_index, embedding_vector), ...]
    Usa Aurora Data API con batch-execute-statement.
    Asume tabla `chunks` con columnas: source_key, chunk_index, embedding (vector), tenant.
    """
    sql = """
        UPDATE chunks
        SET embedding = :embedding::vector
        WHERE source_key = :source_key AND chunk_index = :chunk_index
    """
    params_set = [
        {
            "parameters": [
                {"name": "embedding",    "value": {"stringValue": json.dumps(emb)}},
                {"name": "source_key",   "value": {"stringValue": src}},
                {"name": "chunk_index",  "value": {"longValue": idx}}
            ]
        }
        for src, idx, emb in rows
    ]

    # batch_execute_statement procesa en lotes; para volúmenes grandes, paginar de a 1000
    updated = 0
    for i in range(0, len(params_set), 1000):
        chunk = params_set[i:i+1000]
        rds.batch_execute_statement(
            resourceArn=AURORA_CLUSTER_ARN,
            secretArn=AURORA_SECRET_ARN,
            database=DB_NAME,
            sql=sql,
            parameterSets=[p["parameters"] for p in chunk]
        )
        updated += len(chunk)
    return updated


def lambda_handler(event, context):
    bucket  = event["bucket"]
    tenant  = event["tenant"]
    run_id  = event["run_id"]
    prefix  = f"embeddings-output/{tenant}/{run_id}/"

    output_files = list_output_files(bucket, prefix)
    if not output_files:
        raise ValueError(f"No se encontraron archivos de output en {prefix}")

    rows = []
    for key in output_files:
        obj = s3.get_object(Bucket=bucket, Key=key)
        for line in obj["Body"].read().decode("utf-8").splitlines():
            if not line.strip():
                continue
            record = json.loads(line)
            source_key, chunk_idx = parse_record_id(record["recordId"])
            embedding = record["modelOutput"]["embeddings"][0]
            rows.append((source_key, chunk_idx, embedding))

    total_updated = bulk_upsert(rows)

    summary = {
        "run_id": run_id,
        "tenant": tenant,
        "total_vectors_inserted": total_updated
    }
    s3.put_object(
        Bucket=bucket,
        Key=f"pipeline-results/{run_id}/final_summary.json",
        Body=json.dumps(summary, indent=2).encode()
    )

    return summary
```

