## Componente 1 — ECS Extractor (modificación)

### Cambios sobre `ecs-extractor/extractor/main.py`

Agregar lógica de chunking y generación de JSONL después de la extracción exitosa:

```python
"""
Bulkrag ECS Extractor — Pipeline completo
Extrae texto + chunkea + genera JSONL para batch embeddings.
"""
import os, json, time, traceback, io, uuid
from concurrent.futures import ProcessPoolExecutor, as_completed
import boto3
import pdfplumber

BUCKET         = os.environ["RAG_BUCKET_NAME"]
MANIFEST_KEY   = os.environ["MANIFEST_S3_KEY"]
TENANT         = os.environ["TENANT"]
RUN_ID         = os.environ["RUN_ID"]
REGION         = os.environ.get("AWS_REGION", "us-east-1")
WORKER_COUNT   = int(os.environ.get("WORKER_COUNT", "5"))
MAX_FILE_MB    = int(os.environ.get("MAX_FILE_SIZE_MB", "30"))
CHUNK_SIZE     = int(os.environ.get("CHUNK_SIZE_TOKENS", "500"))
CHUNK_OVERLAP  = int(os.environ.get("CHUNK_OVERLAP_TOKENS", "50"))

s3 = boto3.client("s3", region_name=REGION)


def read_manifest() -> list[str]:
    obj = s3.get_object(Bucket=BUCKET, Key=MANIFEST_KEY)
    return json.loads(obj["Body"].read())["keys"]


def chunk_text(text: str, chunk_size: int, overlap: int) -> list[str]:
    """
    Chunking simple por palabras (aproximación de tokens).
    Para producción evaluar tiktoken o el tokenizer de Cohere para precisión exacta.
    """
    words = text.split()
    if not words:
        return []
    chunks, start = [], 0
    step = max(chunk_size - overlap, 1)
    while start < len(words):
        chunk_words = words[start : start + chunk_size]
        chunks.append(" ".join(chunk_words))
        start += step
    return chunks


def process_pdf(pdf_key: str) -> dict:
    """Procesa un PDF: extrae, chunkea, escribe output + jsonl. Retorna resultado."""
    t0 = time.time()
    try:
        head = s3.head_object(Bucket=BUCKET, Key=pdf_key)
        size_mb = head["ContentLength"] / (1024 * 1024)
        if size_mb > MAX_FILE_MB:
            return _result(pdf_key, "SKIPPED_TOO_LARGE", t0, size_mb=size_mb)

        obj = s3.get_object(Bucket=BUCKET, Key=pdf_key)
        pdf_bytes = obj["Body"].read()

        with pdfplumber.open(io.BytesIO(pdf_bytes)) as pdf:
            pages_text = [p.extract_text().strip() for p in pdf.pages if p.extract_text()]
            full_text = "\n\n".join(pages_text)

        if not full_text.strip():
            return _result(pdf_key, "EMPTY_TEXT", t0, size_mb=size_mb)

        # 1. Escribir .txt en output/ (mismo naming original)
        output_key = f"batch-poc/output/{TENANT}/{RUN_ID}/{pdf_key}.txt"
        s3.put_object(Bucket=BUCKET, Key=output_key, Body=full_text.encode("utf-8"))

        # 2. Chunkear y escribir JSONL para embeddings batch
        chunks = chunk_text(full_text, CHUNK_SIZE, CHUNK_OVERLAP)
        jsonl_lines = []
        for i, chunk in enumerate(chunks):
            chunk_id = f"{pdf_key}::chunk_{i:04d}"
            jsonl_lines.append(json.dumps({
                "recordId": chunk_id,
                "modelInput": {
                    "texts":      [chunk],
                    "input_type": "search_document"
                },
                # Metadata propia para mapear de vuelta en la inserción
                "_meta": {
                    "source_key": pdf_key,
                    "chunk_index": i,
                    "tenant": TENANT
                }
            }))

        jsonl_key = f"pending-embeddings/{TENANT}/{RUN_ID}/{pdf_key}.jsonl"
        s3.put_object(
            Bucket=BUCKET,
            Key=jsonl_key,
            Body="\n".join(jsonl_lines).encode("utf-8")
        )

        return _result(pdf_key, "OK", t0, size_mb=size_mb, chunks=len(chunks))

    except Exception:
        return _result(pdf_key, "ERROR", t0, error=traceback.format_exc()[:500])


def _result(key, status, t0, **extra) -> dict:
    return {"key": key, "status": status, "duration_sec": round(time.time() - t0, 2), **extra}


def write_log(result: dict) -> None:
    log_key = f"batch-poc/logs/{TENANT}/{RUN_ID}/{result['key']}.json"
    s3.put_object(Bucket=BUCKET, Key=log_key, Body=json.dumps(result).encode())


def write_summary(results: list[dict]) -> None:
    base = MANIFEST_KEY.split("/")[-1].replace(".json", "")
    summary_key = f"batch-poc/results/{TENANT}/{RUN_ID}/{base}_summary.json"

    by_status = {}
    for r in results:
        by_status[r["status"]] = by_status.get(r["status"], 0) + 1

    total_chunks = sum(r.get("chunks", 0) for r in results)
    total_sec    = sum(r["duration_sec"] for r in results)

    summary = {
        "manifest":     MANIFEST_KEY,
        "tenant":       TENANT,
        "run_id":       RUN_ID,
        "total":        len(results),
        "by_status":    by_status,
        "total_chunks": total_chunks,
        "total_sec":    round(total_sec, 2),
        "avg_sec_file": round(total_sec / len(results), 2) if results else 0
    }
    s3.put_object(Bucket=BUCKET, Key=summary_key, Body=json.dumps(summary, indent=2).encode())
    print(f"[SUMMARY] {json.dumps(by_status)} chunks={total_chunks} key={summary_key}")


def main():
    keys = read_manifest()
    print(f"[START] tenant={TENANT} run_id={RUN_ID} files={len(keys)} workers={WORKER_COUNT}")

    results = []
    with ProcessPoolExecutor(max_workers=WORKER_COUNT) as executor:
        futures = {executor.submit(process_pdf, k): k for k in keys}
        for i, future in enumerate(as_completed(futures), 1):
            result = future.result()
            write_log(result)
            results.append(result)
            print(f"[{i}/{len(keys)}] {result['status']} {result['key']}")

    write_summary(results)
    print("[END]")


if __name__ == "__main__":
    main()
```

