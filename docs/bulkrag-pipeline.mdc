## Componente 5 — Step Functions: definición ASL

### `step-functions/bulkrag-pipeline.asl.json`

```json
{
  "Comment": "Bulkrag — Pipeline completo de carga masiva RAG",
  "StartAt": "ListPdfsAndBuildManifests",
  "States": {
    "ListPdfsAndBuildManifests": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ListManifestsLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "run_id.$": "$.Payload.run_id",
        "tenant.$": "$.Payload.tenant",
        "bucket.$": "$.Payload.bucket",
        "total_files.$": "$.Payload.total_files",
        "manifest_keys.$": "$.Payload.manifest_keys"
      },
      "ResultPath": "$.listResult",
      "Next": "RunExtractionTasks"
    },

    "RunExtractionTasks": {
      "Type": "Map",
      "ItemsPath": "$.listResult.manifest_keys",
      "MaxConcurrency": 10,
      "ItemSelector": {
        "manifest_key.$": "$$.Map.Item.Value",
        "tenant.$": "$.listResult.tenant",
        "run_id.$": "$.listResult.run_id",
        "bucket.$": "$.listResult.bucket"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "RunEcsExtractionTask",
        "States": {
          "RunEcsExtractionTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "Cluster": "${EcsClusterArn}",
              "TaskDefinition": "${EcsTaskDefinitionArn}",
              "LaunchType": "FARGATE",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ${EcsSubnetIds},
                  "SecurityGroups": ["${EcsSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "extractor",
                    "Environment": [
                      { "Name": "MANIFEST_S3_KEY", "Value.$": "$.manifest_key" },
                      { "Name": "TENANT",          "Value.$": "$.tenant" },
                      { "Name": "RUN_ID",          "Value.$": "$.run_id" },
                      { "Name": "RAG_BUCKET_NAME", "Value.$": "$.bucket" }
                    ]
                  }
                ]
              }
            },
            "Retry": [
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 30,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": "$.extractionResults",
      "Next": "ConsolidateChunks"
    },

    "ConsolidateChunks": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ConsolidateChunksLambdaArn}",
        "Payload": {
          "bucket.$": "$.listResult.bucket",
          "tenant.$": "$.listResult.tenant",
          "run_id.$": "$.listResult.run_id"
        }
      },
      "ResultSelector": {
        "batch_input_keys.$": "$.Payload.batch_input_keys",
        "total_chunks.$": "$.Payload.total_chunks"
      },
      "ResultPath": "$.consolidateResult",
      "Next": "LaunchBedrockBatchJobs"
    },

    "LaunchBedrockBatchJobs": {
      "Type": "Map",
      "ItemsPath": "$.consolidateResult.batch_input_keys",
      "MaxConcurrency": 5,
      "ItemSelector": {
        "input_key.$": "$$.Map.Item.Value",
        "tenant.$": "$.listResult.tenant",
        "run_id.$": "$.listResult.run_id",
        "bucket.$": "$.listResult.bucket",
        "batch_index.$": "$$.Map.Item.Index"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "CreateModelInvocationJob",
        "States": {
          "CreateModelInvocationJob": {
            "Type": "Task",
            "Resource": "arn:aws:states:::bedrock:createModelInvocationJob.sync",
            "Parameters": {
              "JobName.$": "States.Format('bulkrag-{}-{}-batch{}', $.tenant, $.run_id, $.batch_index)",
              "ModelId": "cohere.embed-multilingual-v3",
              "RoleArn": "${BedrockBatchRoleArn}",
              "InputDataConfig": {
                "S3InputDataConfig": {
                  "S3Uri.$": "States.Format('s3://{}/{}', $.bucket, $.input_key)",
                  "S3InputFormat": "JSONL"
                }
              },
              "OutputDataConfig": {
                "S3OutputDataConfig": {
                  "S3Uri.$": "States.Format('s3://{}/embeddings-output/{}/{}/batch_{}/', $.bucket, $.tenant, $.run_id, $.batch_index)"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": ["Bedrock.ThrottlingException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": "$.bedrockResults",
      "Next": "InsertVectorsToPgvector"
    },

    "InsertVectorsToPgvector": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${InsertPgvectorLambdaArn}",
        "Payload": {
          "bucket.$": "$.listResult.bucket",
          "tenant.$": "$.listResult.tenant",
          "run_id.$": "$.listResult.run_id"
        }
      },
      "ResultPath": "$.finalResult",
      "End": true
    }
  }
}
```

### Notas sobre la integración `.sync`

- **`ecs:runTask.sync`**: Step Functions espera nativamente a que la task ECS llegue a `STOPPED`. Si el container exit code es distinto de 0, la integración falla automáticamente y dispara el `Retry`.
- **`bedrock:createModelInvocationJob.sync`**: requiere que el rol de ejecución de Step Functions tenga permisos para `bedrock:GetModelInvocationJob` (usado internamente por el polling administrado del servicio).
- Los `Map` con `MaxConcurrency` controlan cuántas ECS Tasks o Bedrock Jobs corren en paralelo — ajustar según cuotas de cuenta.

